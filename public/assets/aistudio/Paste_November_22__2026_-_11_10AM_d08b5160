                </button>
            </div>
        </div>

        <!-- Мобільне випадаюче меню -->
        <div id="mobile-menu" class="hidden md:hidden bg-harmony-cream border-b border-stone-200 px-4 pt-2 pb-6 space-y-3">
            <a href="#approach" class="block py-2 text-base font-medium text-stone-700">Наш підхід</a>
            <a href="#schools" class="block py-2 text-base font-medium text-stone-700">Для шкіл в Україні</a>
            <a href="#impact" class="block py-2 text-base font-medium text-stone-700">Вплив</a>
            <a href="#news" class="block py-2 text-base font-medium text-stone-700">Новини</a>
