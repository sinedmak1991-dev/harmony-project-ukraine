    <!-- 1. HERO СЕКЦІЯ (Освіта в гармонії з життям) -->
    <section class="relative overflow-hidden pt-10 pb-16 lg:pt-16 lg:pb-24">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid lg:grid-cols-12 gap-12 items-center">
                <!-- Ліва колонка: текст -->
                <div class="lg:col-span-6 space-y-6">
                    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-harmony-sage text-harmony-dark text-xs font-medium">
                        <i data-lucide="sprout" class="w-4 h-4 text-harmony-primary"></i>
                        Вкорінені в природі. Створені для нашого майбутнього.
                    </div>
                    <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold text-harmony-dark leading-[1.12]">
                        Освіта <br>в гармонії з життям.
                    </h1>
                    <p class="text-lg text-stone-600 max-w-xl leading-relaxed">
                        Ми допомагаємо дітям і молоді розкривати потенціал, спираючись на принципи природи. Для мирного, стійкого і кращого майбутнього України.
                    </p>
                    <div class="flex flex-wrap items-center gap-4 pt-2">
                        <a href="#approach" class="inline-flex items-center gap-2 bg-harmony-primary hover:bg-harmony-dark text-white font-medium px-6 py-3.5 rounded-full transition-all shadow-sm">
                            Відкрити наш підхід
                            <i data-lucide="arrow-right" class="w-4 h-4"></i>
                        </a>
                        <a href="#schools" class="inline-flex items-center gap-2 bg-white hover:bg-harmony-sage text-harmony-dark border border-stone-200 font-medium px-6 py-3.5 rounded-full transition-all">
